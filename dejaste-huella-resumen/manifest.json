  "subtitulos": {
    "activo": true,
    "estilo": "editorial",
    "sombra": true,
    "frases": [
      {
        "texto": "el médico / me dijo",
        "palabras": 6,
        "y": 56
      },
      {
        "texto": "que no había / nada que hacer",
        "palabras": 9,
        "y": 56
      },
      {
        "texto": "que era solamente / _tres meses_ / de vida",
        "palabras": 7,
        "y": 56
      },
      {
        "texto": "entonces nos duró / *dos años*",
        "palabras": 5,
        "y": 60,
        "hasta_s": 7.95
      },
      {
        "texto": "¿y qué era lo que / él hacía",
        "palabras": 7,
        "y": 60
      },
      {
        "texto": "cuando llegabas / a casa?",
        "palabras": 4,
        "y": 60,
        "hasta_s": 13.58
      },
      {
        "texto": "cuando llegaba, / sabes que",
        "palabras": 4,
        "y": 56
      },
      {
        "texto": "siempre que / escuchaba el _timbre_",
        "palabras": 6,
        "y": 56
      },
      {
        "texto": "o ya sentía / las _llaves_",
        "palabras": 5,
        "y": 56
      },
      {
        "texto": "él ya estaba / en la _puerta_",
        "palabras": 6,
        "y": 56,
        "hasta_s": 21.83
      },
      {
        "texto": "cuando nosotros / le hablábamos",
        "palabras": 5,
        "y": 56
      },
      {
        "texto": "él movía / sus _cejas_",
        "palabras": 4,
        "y": 56,
        "hasta_s": 25.98
      },
      {
        "texto": "y era como",
        "palabras": 2,
        "y": 60
      },
      {
        "texto": "¿cómo lo haces?",
        "palabras": 3,
        "y": 60
      },
      {
        "texto": "o sea, ¿cómo me / *entiendes?*",
        "palabras": 5,
        "y": 60
      },
      {
        "texto": "¿y qué es lo que / más _extrañas_",
        "palabras": 7,
        "y": 60
      },
      {
        "texto": "en tu día a día?",
        "palabras": 5,
        "y": 60,
        "hasta_s": 31.59
      },
      {
        "texto": "creo que escuchar / sus _paticas_",
        "palabras": 5,
        "y": 60
      },
      {
        "texto": "cuando se está / corriendo / de un lado a otro",
        "palabras": 8,
        "y": 60
      },
      {
        "texto": "en el apartamento",
        "palabras": 3,
        "y": 60,
        "hasta_s": 37.81
      },
      {
        "texto": "estábamos solos",
        "palabras": 3,
        "y": 56
      },
      {
        "texto": "y él se acercó / a mí",
        "palabras": 5,
        "y": 56
      },
      {
        "texto": "y fue como algo / muy *íntimo*",
        "palabras": 6,
        "y": 56,
        "hasta_s": 45.23
      },
      {
        "texto": "ya no, no se volvió / a _parar_",
        "palabras": 7,
        "y": 60
      },
      {
        "texto": "yo ya *sabía*",
        "palabras": 3,
        "y": 60,
        "hasta_s": 50.88
      },
      {
        "texto": "ya era / el _momento_",
        "palabras": 4,
        "y": 56
      },
      {
        "texto": "y yo tomé / la decisión",
        "palabras": 5,
        "y": 56
      },
      {
        "texto": "por todos / y por ambos",
        "palabras": 7,
        "y": 56,
        "hasta_s": 58.34
      },
      {
        "texto": "y su _mirada_ / lo decía",
        "palabras": 5,
        "y": 60,
        "hasta_s": 60.24
      },
      {
        "texto": "es un *acto de amor* / lo que hacemos",
        "palabras": 8,
        "y": 60,
        "hasta_s": 62.31
      },
      {
        "texto": "duele / _muy profundo_",
        "palabras": 3,
        "y": 60
      },
      {
        "texto": "¿qué sentiste / cuando llegaste / aquí ese día?",
        "palabras": 7,
        "y": 60,
        "hasta_s": 67.57
      },
      {
        "texto": "que le estaba dando / la despedida / que _merecía_",
        "palabras": 8,
        "y": 60,
        "hasta_s": 70.02
      },
      {
        "texto": "y que Sam / se sintió _acompañado_",
        "palabras": 6,
        "y": 56
      },
      {
        "texto": "hasta el último / momento",
        "palabras": 4,
        "y": 56
      },
      {
        "texto": "hasta el último / segundo",
        "palabras": 4,
        "y": 56
      },
      {
        "texto": "y se sintió / *tan amado*",
        "palabras": 6,
        "y": 56,
        "hasta_s": 76.77
      },
      {
        "texto": "Sam era / la razón",
        "palabras": 3,
        "y": 56
      },
      {
        "texto": "porque nosotros / estuvimos *juntos*",
        "palabras": 4,
        "y": 56
      },
      {
        "texto": "entonces, ¿cómo no / estar con él",
        "palabras": 6,
        "y": 56
      },
      {
        "texto": "para su *despedida*",
        "palabras": 3,
        "y": 56,
        "hasta_s": 85.51
      }
    ],
    "cursiva_oro": true
  },
